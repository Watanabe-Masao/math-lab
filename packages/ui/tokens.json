    "$description": "動きは「何が変わったか」を伝えるためだけ。1つの操作に動きは1つ。動きを減らす設定では全部止める。",
    "dur-press": {
      "$type": "duration",
      "$value": "90ms",
      "$description": "押した瞬間の返事（沈む）"
    },
    "dur": {
      "$type": "duration",
      "$value": "200ms",
      "$description": "変わった所が動く（滑る・伸びる・数が変わる）"
    },
    "dur-flash": {
      "$type": "duration",
      "$value": "700ms",
      "$description": "結果が出た所を一度だけ淡く光らせる"
    },
    "dur-sheet": {
      "$type": "duration",
      "$value": "320ms",
      "$description": "シートが段に止まる・開く・閉じる"
    },
    "ease-sheet": {
      "$type": "cubicBezier",
      "$value": [
        0.32,
        0.72,
        0,
        1
      ],
      "$description": "シートの曲線（iPhone のシートに近い、勢いよく出てやわらかく止まる）"
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.8,
        0.2,
        1
      ],
      "$description": "動きの曲線（すっと止まる）"
    },
    "press-scale": {
      "$type": "number",
      "$value": 0.97,
      "$description": "押したときの縮み"
    }
