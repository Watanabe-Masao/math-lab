{
  "name": "math-lab",
  "private": true,
  "type": "module",
  "description": "統計を発見する環境の土台：計算（種つき乱数・実験エンジン・式の木）と画面の部品",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "springs": "node packages/ui/scripts/spring.mjs",
    "tokens": "node packages/ui/scripts/spring.mjs && node packages/ui/scripts/tokens.mjs",
    "design": "node scripts/check-design.mjs",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/ui --noEmit",
    "test": "vitest run",
    "check": "npm run design && npm run typecheck && node scripts/bundle-formula.mjs --check && node scripts/sync-stats2.mjs && npm run test",
    "bundle": "node scripts/bundle-formula.mjs",
    "sync": "node scripts/sync-stats2.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-toggle-group": "1.2.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.16",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
